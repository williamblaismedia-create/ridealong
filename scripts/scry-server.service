# Scry — MCP + live-view server unit.
#
# This is a systemd --user unit: it lives in ~/.config/systemd/user/ on
# w-agent (copied there at deploy time — see docs/DEPLOIEMENT-W-AGENT.md),
# NOT a system-wide unit under /etc/systemd or /usr/lib/systemd. Manage it
# with `systemctl --user ...`, never plain `systemctl ...`.
#
# For it to stay up across logout and reboot without an active login
# session (same pattern as w-agent's other user services), linger must be
# enabled once for this user:
#   loginctl enable-linger will
#
# Secrets/config (SCRY_CDP_URL, SCRY_DATA_DIR, SCRY_LIVE_SECRET,
# SCRY_LIVE_PORT) come from EnvironmentFile below, which lives outside
# git and outside ~/projets — never in this repo.
#
# Install / start:
#   systemctl --user daemon-reload
#   systemctl --user enable --now scry-server

[Unit]
Description=Scry — MCP + live-view server
After=scry-chrome.service

[Service]
ExecStart=/usr/bin/node %h/scry/dist/src/server.js
EnvironmentFile=%h/scry-donnees/scry.env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
